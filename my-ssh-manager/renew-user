#!/bin/bash

# Colors for UI matching
G='\033[1;32m'
NC='\033[0m'

clear
echo -e "${G}========================================${NC}"
echo -e "${G}            RENEW VPN USER              ${NC}"
echo -e "${G}========================================${NC}"
read -p "Username to Renew : " USER

# Verify the user actually exists
if ! id -u "$USER" > /dev/null 2>&1; then
    echo -e "\nError: User '$USER' does not exist on this server."
    sleep 2
    menu
    exit 1
fi

read -p "Extend by (Days)  : " DAYS

# Calculate the new expiration date from today
EXP_DATE=$(date -d "+${DAYS} days" +"%Y-%m-%d")

# Update the account expiry parameter in the system
usermod -e "$EXP_DATE" "$USER"

echo -e "\n${G}========================================${NC}"
echo -e "Success! Account '${USER}' renewed."
echo -e "New Expiration Date: ${EXP_DATE}"
echo -e "${G}========================================${NC}"
read -n 1 -s -r -p "Press any key to return to the menu..."
menu
