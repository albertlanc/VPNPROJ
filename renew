#!/bin/bash
NC='\e[0m'
GREEN='\e[0;32m'
YELLOW='\e[1;33m'
BLUE='\e[0;34m'
RED='\e[1;31m'

clear
echo -e "${BLUE}======================================${NC}"
echo -e "${YELLOW}          RENEW SSH ACCOUNT           ${NC}"
echo -e "${BLUE}======================================${NC}"
printf "${GREEN}%-5s %-15s %s${NC}\n" "NO" "USER" "EXPIRES"
echo -e "${BLUE}======================================${NC}"

count=1
declare -A user_map

for user in $(awk -F: '($3 >= 1000 && $1 != "nobody") {print $1}' /etc/passwd); do
    exp=$(chage -l "$user" | grep "Account expires" | awk -F": " '{print $2}')
    if [[ "$exp" == "never" ]]; then
        exp_fmt="Never"
    else
        exp_fmt=$(date -d "$exp" +"%d-%b-%Y")
    fi
    printf "${GREEN}%-5s %-15s %s${NC}\n" "$count." "$user" "$exp_fmt"
    user_map[$count]=$user
    ((count++))
done

printf "${GREEN}%-5s %s${NC}\n" "0." "Back to Menu"
echo -e "${BLUE}======================================${NC}"
echo -ne "${GREEN}Select Number or Username : ${NC}"; read choice

if [[ "$choice" == "0" || -z "$choice" ]]; then
    exit 0
fi

target_user=""
if [[ "$choice" =~ ^[0-9]+$ ]]; then
    target_user=${user_map[$choice]}
else
    target_user=$choice
fi

if [[ -n "$target_user" ]] && id "$target_user" &>/dev/null; then
    echo -ne "${GREEN}Add Days : ${NC}"; read days
    Exp=$(chage -l "$target_user" | grep "Account expires" | awk -F": " '{print $2}')
    if [[ "$Exp" != "never" ]]; then
        Exp_Sec=$(date -d "$Exp" +%s)
        Today=$(date +%s)
        if [[ $Today -ge $Exp_Sec ]]; then
            New_Sec=$((Today + (days * 86400)))
        else
            New_Sec=$((Exp_Sec + (days * 86400)))
        fi
        New_Date=$(date -d @$New_Sec +"%Y-%m-%d")
        chage -E "$New_Date" "$target_user"
        echo -e "\n${GREEN}[SUCCESS]${NC} User $target_user renewed until $(date -d "$New_Date" +"%d-%b-%Y")."
    else
        echo -e "\n${YELLOW}[!]${NC} User $target_user does not have an expiration date set."
    fi
else
    echo -e "\n${RED}[ERROR]${NC} Invalid user or selection."
fi
echo ""
echo -ne "${GREEN}Press any key to back on menu ${NC}"; read -n 1 -s -r
