#!/bin/bash
NC='\e[0m'
GREEN='\e[0;32m'
YELLOW='\e[1;33m'
BLUE='\e[0;34m'
RED='\e[1;31m'

clear
echo -e "${BLUE}======================================${NC}"
echo -e "${YELLOW}          DELETE SSH ACCOUNT          ${NC}"
echo -e "${BLUE}======================================${NC}"
printf "${GREEN}%-5s %-15s %s${NC}\n" "NO" "USER" "EXPIRES"
echo -e "${BLUE}======================================${NC}"

count=1
declare -A user_map

for user in $(awk -F: '($3 >= 1000 && $1 != "nobody") {print $1}' /etc/passwd); do
    exp=$(chage -l "$user" | grep "Account expires" | awk -F": " '{print $2}')
    if [[ "$exp" == "never" ]]; then
        exp_fmt="Never"
    else
        exp_fmt=$(date -d "$exp" +"%d-%b-%Y")
    fi
    printf "${GREEN}%-5s %-15s %s${NC}\n" "$count." "$user" "$exp_fmt"
    user_map[$count]=$user
    ((count++))
done

printf "${GREEN}%-5s %s${NC}\n" "0." "Back to Menu"
echo -e "${BLUE}======================================${NC}"
echo -ne "${GREEN}Select Number or Username : ${NC}"; read choice

if [[ "$choice" == "0" || -z "$choice" ]]; then
    exit 0
fi

target_user=""
if [[ "$choice" =~ ^[0-9]+$ ]]; then
    target_user=${user_map[$choice]}
else
    target_user=$choice
fi

if [[ -n "$target_user" ]] && id "$target_user" &>/dev/null; then
    userdel -f "$target_user"
    echo -e "\n${GREEN}[SUCCESS]${NC} User $target_user successfully deleted."
else
    echo -e "\n${RED}[ERROR]${NC} Invalid user or selection."
fi
echo ""
echo -ne "${GREEN}Press any key to back on menu ${NC}"; read -n 1 -s -r
